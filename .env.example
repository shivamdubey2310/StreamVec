# PostgreSQL + pgvector
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=streamvec
POSTGRES_USER=streamvec
POSTGRES_PASSWORD=streamvec_pass

# Redis (SHA-256 Dedup Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DEDUP_TTL_SECONDS=2592000

# Apache Kafka (KRaft)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_RAW_TOPIC=raw_documents
KAFKA_DLQ_TOPIC=documents_dlq
KAFKA_CONSUMER_GROUP=streamvec-workers

# Embedding & Stream Worker Config
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_MODEL_VERSION=bge-small-en-v1.5-384d
WORKER_BATCH_SIZE=32
WORKER_BATCH_TIMEOUT_SEC=1.0
CHUNK_SIZE_CHARS=800
CHUNK_OVERLAP_CHARS=120

# FastAPI Retrieval Service
API_HOST=0.0.0.0
API_PORT=8000
RRF_K=60